{
  "name": "@thxp/claude-code-router-workspace",
  "version": "3.2.10",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "scripts": {
    "build": "pnpm build:shared && pnpm build:core && pnpm build:server && pnpm build:cli && pnpm build:ui",
    "build:core": "pnpm --filter @thxp/llms build",
    "build:shared": "pnpm --filter @thxp/shared build",
    "build:cli": "pnpm --filter @thxp/claude-code-router build",
    "build:server": "pnpm --filter @thxp/server build",
    "build:ui": "pnpm --filter @thxp/ui build",
    "build:docs": "pnpm --filter claude-code-router-docs build",
    "release": "pnpm build && bash scripts/release.sh",
    "release:npm": "bash scripts/release.sh",
    "dev:cli": "pnpm --filter @thxp/claude-code-router dev",
    "dev:server": "pnpm --filter @thxp/server dev",
    "dev:ui": "pnpm --filter @thxp/ui dev",
    "dev:core": "pnpm --filter @thxp/llms dev",
    "dev:docs": "pnpm --filter claude-code-router-docs start",
    "serve:docs": "pnpm --filter claude-code-router-docs serve"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "musistudio",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.15",
    "esbuild": "^0.25.1",
    "shx": "^0.4.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "@types/react": "18"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
